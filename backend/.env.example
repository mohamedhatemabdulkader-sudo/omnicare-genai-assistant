# --- LLM (required) --------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Vector store -----------------------------------------------------------
# Leave QDRANT_URL empty to use an embedded local Qdrant (no account needed).
# Set both to use Qdrant Cloud (free tier): https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# --- Safety -----------------------------------------------------------------
# Second-layer Gemini prompt-injection classifier (one extra LLM call per message).
GUARD_LLM_ENABLED=true
